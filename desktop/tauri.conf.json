{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spectrum Tenant POC",
  "version": "0.1.0",
  "identifier": "com.spectrum.tenant.poc",
  "build": {
    "frontendDist": "../frontend/build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Spectrum Tenant POC",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
